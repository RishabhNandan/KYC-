generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  SUPER_ADMIN
  CO_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(CO_ADMIN)
  status          UserStatus       @default(ACTIVE)
  phone           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recommendations Recommendation[]
  auditLogs       AuditLog[]
}

model Doctor {
  id              String           @id @default(uuid())
  name            String
  regNumber       String           @unique
  department      String
  designation     String
  email           String?
  phone           String?
  status          DoctorStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recommendations Recommendation[]
}

model Patient {
  id              String           @id @default(uuid())
  patientId       String           @unique
  name            String
  age             Int
  gender          String
  phone           String?
  address         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recommendations Recommendation[]
}

model Recommendation {
  id                     String   @id @default(uuid())
  recordId               String   @unique
  doctorId               String
  doctor                 Doctor   @relation(fields: [doctorId], references: [id])
  patientId              String
  patient                Patient  @relation(fields: [patientId], references: [id])
  createdById            String
  createdBy              User     @relation(fields: [createdById], references: [id])
  date                   DateTime @default(now())
  diagnosis              String
  recommendation         String
  followUp               String?
  additionalInstructions String?
  remarks                String?
  authorizedPerson       String
  signatureData          String?  // Base64 signature image or drawn canvas string
  pdfGenerated           Boolean  @default(true)
  status                 String   @default("FINALIZED") // DRAFT or FINALIZED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  userRole  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
}

model HospitalSettings {
  id             String   @id @default("default")
  hospitalName   String   @default("SHANTI NEURO CLINIC")
  tagline        String?  @default("Advanced Neurological Care & Rehabilitation Center")
  address        String   @default("102 Neuro Care Tower, Health Avenue, Medical District, City - 400001")
  phone          String   @default("+91 98765 43210 / +91 022 2847 9900")
  email          String   @default("contact@shantineuroclinic.com")
  website        String   @default("www.shantineuroclinic.com")
  licenseNo      String   @default("HOSP-NC-2026-8899")
  logoUrl        String?
  disclaimerText String?  @default("This official recommendation document is generated based solely on authorized medical personnel's manually entered clinical observations and instructions at Shanti Neuro Clinic.")
  updatedAt      DateTime @updatedAt
}
